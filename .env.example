# LLM backend — any OpenAI-compatible endpoint (z.ai GLM, OpenAI, Ollama, vLLM, ...)
LLMC_BASE_URL=https://api.z.ai/api/paas/v4
LLMC_API_KEY=replace-me
LLMC_MODEL=glm-4.7
# Small/cheap model for routing fallback (used when Jev is unavailable/low-confidence)
LLMC_SMALL_MODEL=glm-4-flash

# Jev-compatible decision models (Typesafe AI System One) — primary router decider
TYPESAFE_API_KEY=
TYPESAFE_JEV_MODEL=jev-latest

# Storage
DATABASE_URL=postgresql://llmc:llmc@localhost:5432/llmc
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=llmcdevpass
DUCKDB_PATH=./data/analytics.duckdb

# Mocked payments (stripe-mock container) — never real charges
PAYMENTS_BASE_URL=http://localhost:12111
PAYMENTS_STRIPE_KEY=sk_test_mock
